# Copia este archivo, llama a la copia ".env" y pon tus claves de verdad.
# El archivo .env no se sube a GitHub (está en el .gitignore).
ANTHROPIC_API_KEY=pon-aqui-tu-clave

# WhatsApp (Meta for Developers → tu app → WhatsApp → Paso 1. Probar)
# Token de acceso: el temporal dura 24 horas
WHATSAPP_TOKEN=pon-aqui-el-token
# Identificador del número de teléfono de prueba (no es el número en sí)
WHATSAPP_PHONE_NUMBER_ID=pon-aqui-el-identificador
# Una palabra secreta que te inventas tú; la pondrás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=inventate-una-palabra
